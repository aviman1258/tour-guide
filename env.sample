# Copy this file to `.env` (gitignored). Loaded by `node --env-file-if-exists=.env`.

# Anthropic API key. If missing, the server falls back to shelling out to the
# Claude Code CLI (`claude -p`), which uses your Claude subscription instead.
ANTHROPIC_API_KEY=

PORT=3001

# Routing server. Public demo is rate-limited (1 req/s) with no uptime guarantee.
OSRM_BASE_URL=https://router.project-osrm.org

# Models. Strong = itinerary + narration. Fast = "suggest more".
MODEL_STRONG=claude-opus-5
MODEL_FAST=claude-haiku-4-5

# Identifies this app to Wikipedia / Nominatim / OSM (required by their policies).
CONTACT=achandra@costar.com
